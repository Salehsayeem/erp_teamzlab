# Copy to .env and fill real values. .env is gitignored — credentials never enter the repo.

# --- API database (EF connection name "Default") ---
# Assembled by DbConfig into Host=…;Port=…;Database=…;Username=…;Password=…
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# --- Optional ---
# Browser origins allowed to call the API, comma-separated. Default: http://localhost:3000
#CorsOrigins=http://localhost:3000

# --- API test suite server (throwaway erp_test_* databases; needs CREATEDB rights) ---
# These are read as REAL environment variables by the test fixtures, not from this file
# (tests read them before the .env loader runs). Defaults if unset:
#   TESTPGHOST=localhost  TESTPGPORT=5432  TESTPGUSER=postgres  TESTPGPASSWORD=postgres
